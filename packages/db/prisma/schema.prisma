// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Availability {
  ACTIVE
  OPEN
  BUSY
}

enum IntentType {
  DSA
  HACKATHON
  PROJECT
  OPENSOURCE
}

enum MatchStatus {
  PENDING
  MATCHED
  REJECTED
  UNMATCHED
}
enum ActionType {
  ACCEPTED
  REJECTED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}

enum MatchCompatibility {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum MatchLevelSource {
  CODEFORCES
  LEETCODE
  MIXED_CP
  GITHUB
  UNKNOWN
}

enum CollaborationMode {
  SIMILAR
  COMPLEMENTARY
  EITHER
}

enum CollaborationRole {
  FRONTEND
  BACKEND
  FULL_STACK
  MOBILE
  ML_AI
  DATA
  DEVOPS_CLOUD
  BLOCKCHAIN
  UI_UX
  TESTING_QA
  PRODUCT
}

enum DsaGoal {
  INTERVIEW_PREP
  COMPETITIVE_PROGRAMMING
}

enum DsaProviderPreference {
  CODEFORCES
  LEETCODE
  EITHER
}

enum OpenSourceContributionType {
  CODE
  DOCUMENTATION
  TESTING
  DEVOPS_CI
  DESIGN
  ISSUE_TRIAGE
  PROJECT_MAINTENANCE
}

enum ResolvedMatchMode {
  SIMILAR
  COMPLEMENTARY
  DIRECT
}

enum ConnectionContext {
  DSA
  HACKATHON
  PROJECT
  OPENSOURCE
  GENERAL
}

enum ConnectionStatus {
  PENDING
  MATCHED
}

enum MessageType {
  TEXT
  CODE_SNIPPET
  LINK
}

model User{
  id           String        @id @default(uuid())
  email        String        @unique
  username     String        @unique
  githubId     String?       @unique
  password     String?
  displayName  String
  avatarUrl    String?
  college      String?
  bio          String?
  availability Availability  @default(ACTIVE)
  matchPreferencesRevision Int @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  searchIntent SearchIntent?
  openToIntents OpenToIntent[]
  intentConfigurations IntentConfiguration[]
  matchesAsA   Match[]       @relation("MatchUserA")
  matchesAsB   Match[]       @relation("MatchUserB")
}
model Profile {
    userId             String    @id
    user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    githubUsername     String?
    leetcodeHandle     String?
    codeforcesHandle   String?
    lcContestsAttended  Int?
    lcTotalSolved       Int?
    lcEasySolved        Int?
    lcMediumSolved      Int?
    lcHardSolved        Int?
    topLanguages       String[]
    leetcodeLanguages  String[]  @default([])
    skillTags          String[]
    githubStars        Int       @default(0)
    contributionStreak Int       @default(0)
    githubContributions Json?
    githubTopics       String[]
    githubLastSyncedAt DateTime?
    leetcodeLastSyncedAt DateTime?
    codeforcesLastSyncedAt DateTime?
    lcRating           Int?
    cfRating           Int?
    skillVector        Float[]
    profileScore       Int       @default(0)
    lastSyncedAt       DateTime?
    createdAt          DateTime  @default(now())
    updatedAt          DateTime @default(now()) @updatedAt
  }
model SearchIntent {
  userId     String     @id
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  intentType IntentType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model IntentConfiguration {
  userId     String
  intentType IntentType
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  offeredLanguages         String[]                     @default([])
  offeredFrameworks        String[]                     @default([])
  offeredDomains           String[]                     @default([])
  offeredRoles             CollaborationRole[]          @default([])
  offeredDsaGoals          DsaGoal[]                    @default([])
  offeredContributionTypes OpenSourceContributionType[] @default([])
  offeredRepositoryTopics  String[]                     @default([])

  requiredLanguages         String[]                     @default([])
  requiredFrameworks        String[]                     @default([])
  requiredDomains           String[]                     @default([])
  requiredRoles             CollaborationRole[]          @default([])
  requiredDsaGoals          DsaGoal[]                    @default([])
  requiredContributionTypes OpenSourceContributionType[] @default([])
  requiredRepositoryTopics  String[]                     @default([])

  niceToHaveLanguages         String[]                     @default([])
  niceToHaveFrameworks        String[]                     @default([])
  niceToHaveDomains           String[]                     @default([])
  niceToHaveRoles             CollaborationRole[]          @default([])
  niceToHaveDsaGoals          DsaGoal[]                    @default([])
  niceToHaveContributionTypes OpenSourceContributionType[] @default([])
  niceToHaveRepositoryTopics  String[]                     @default([])

  collaborationMode       CollaborationMode?
  dsaProviderPreference   DsaProviderPreference?
  codeforcesRatingMin     Int?
  codeforcesRatingMax     Int?
  leetcodeGlobalRankBest  Int?
  leetcodeGlobalRankWorst Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, intentType])
  @@index([intentType])
}

model OpenToIntent {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  intentType IntentType
  createdAt  DateTime   @default(now())

  @@unique([userId, intentType])
  @@index([intentType])
}

model OutboxEvent {
  id            String       @id @default(uuid())
  topic         String
  aggregateId   String
  eventType     String
  schemaVersion Int
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  publishedAt   DateTime?
  lockedAt      DateTime?
  lockedBy      String?

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
}
 
// ── MATCH SERVICE DOMAIN ─────────────────────────────────────
model Match {
  id             String      @id @default(uuid())
  userAId        String
  userBId        String
  userA          User        @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User        @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  similarityScore Float?
  compatibility MatchCompatibility?
  levelSource MatchLevelSource?
  resolvedMatchMode ResolvedMatchMode?
  matchedSkills String[] @default([])
  matchedLanguages String[] @default([])
  matchedFrameworks String[] @default([])
  matchedDomains String[] @default([])
  matchedRoles CollaborationRole[] @default([])
  matchedDsaGoals DsaGoal[] @default([])
  matchedContributionTypes OpenSourceContributionType[] @default([])
  matchedRepositoryTopics String[] @default([])
  niceToHaveMatchedGroups Int?
  niceToHaveTotalGroups Int?
  niceToHaveMatchedValues Int?
  explanation Json?
  intentType     IntentType?
  connectionContext ConnectionContext
  status         MatchStatus @default(PENDING)
  matchedAt      DateTime?
  initiatedBy    String
  createdAt      DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  chatRoom        ChatRoom?
  @@unique([userAId, userBId])
}
model MatchAction {
  id          String       @id @default(uuid())
  actorId     String
  targetId    String
  action      ActionType
  intentType  IntentType?
  connectionContext ConnectionContext
  similarityScore Float?
  compatibility MatchCompatibility?
  levelSource MatchLevelSource?
  resolvedMatchMode ResolvedMatchMode?
  matchedSkills String[] @default([])
  matchedLanguages String[] @default([])
  matchedFrameworks String[] @default([])
  matchedDomains String[] @default([])
  matchedRoles CollaborationRole[] @default([])
  matchedDsaGoals DsaGoal[] @default([])
  matchedContributionTypes OpenSourceContributionType[] @default([])
  matchedRepositoryTopics String[] @default([])
  niceToHaveMatchedGroups Int?
  niceToHaveTotalGroups Int?
  niceToHaveMatchedValues Int?
  explanation Json?
  createdAt   DateTime     @default(now())
  @@unique([actorId, targetId, connectionContext])
}

model ConnectionPair {
  pairKey           String           @id
  userAId           String
  userBId           String
  connectionContext ConnectionContext
  status            ConnectionStatus @default(PENDING)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userAId])
  @@index([userBId])
  @@index([status])
}
 
// ── CHAT SERVICE DOMAIN ──────────────────────────────────────
model ChatRoom {
  id        String    @id @default(uuid())
  matchId   String    @unique
  createdAt DateTime  @default(now())
  messages  Message[]
  updatedAt       DateTime    @updatedAt
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
}
 
model Message {
  id         String      @id @default(uuid())
  chatRoomId String
  chatRoom   ChatRoom    @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId   String
  content    String
  type       MessageType @default(TEXT)
  clientMessageId String
  deliveredAt     DateTime?
  readAt          DateTime?
  createdAt  DateTime    @default(now())
  @@unique([chatRoomId, senderId, clientMessageId])
  @@index([chatRoomId, createdAt(sort: Desc)])
}
