# Build backend images in CI. EC2 only pulls the resulting immutable images.
FROM oven/bun:1.3.9-slim AS base
WORKDIR /app

FROM base AS pruner
ARG APP_NAME
RUN bun install --global turbo@2.8.20
COPY . .
# Keep the Turbo version deterministic while producing a minimal workspace tree.
RUN turbo prune ${APP_NAME} --docker

FROM base AS installer
WORKDIR /app
COPY --from=pruner /app/out/json/ ./
RUN bun install --frozen-lockfile
COPY --from=pruner /app/out/full/ ./
# Prisma client generation is local to the image build and requires no database connection.
RUN if [ -d packages/db/prisma ]; then bun run --cwd packages/db prisma:generate; fi

FROM oven/bun:1.3.9-slim AS runtime
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
ARG APP_NAME
ENV NODE_ENV=production
ENV APP_NAME=${APP_NAME}
COPY --from=installer --chown=bun:bun /app /app
USER bun
CMD ["sh", "-c", "bun run --cwd apps/$APP_NAME start"]

# Build with --target migrations --build-arg APP_NAME=db.
FROM runtime AS migrations
CMD ["bun", "run", "--cwd", "packages/db", "prisma:migrate:deploy"]
