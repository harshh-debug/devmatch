{
  "name": "api-gateway",
  "module": "index.ts",
  "type": "module",
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@types/bun": "1.3.9",
    "eslint": "^9.39.1",
    "wait-on": "^9.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "cors": "^2.8.6",
