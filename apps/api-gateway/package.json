  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "wait-on": "^9.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
