# Configure these in Vercel for Preview and Production; do not commit .env.local.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_CHAT_URL=http://localhost:3001
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GITHUB_ID=replace-with-github-oauth-client-id
AUTH_GITHUB_SECRET=replace-with-github-oauth-client-secret
GITHUB_LINK_ID=replace-with-github-link-client-id
GITHUB_LINK_SECRET=replace-with-github-link-client-secret
