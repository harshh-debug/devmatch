# This file documents the runtime contract. Never commit a real runtime.env.
NODE_ENV=production
JWT_SECRET=replace-with-one-long-random-secret
DATABASE_URL=postgresql://pooled-neon-runtime-url
DIRECT_DATABASE_URL=postgresql://direct-neon-migration-url
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
KAFKA_BROKERS=kafka:9092
ALLOWED_ORIGIN=https://app.example.com

API_GATEWAY_PORT=3001
AUTH_SERVICE_URL=http://auth-service:3002
USER_SERVICE_URL=http://user-service:3003
MATCH_SERVICE_URL=http://match-service:3004
CHAT_SERVICE_URL=http://chat-service:3005
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_IP=100

PORT=3002
PROFILE_SYNC_CONCURRENCY=2
WORKER_HEALTH_PORT=3010
GITHUB_TOKEN=replace-with-github-token
