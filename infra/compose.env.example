# Passed to Docker Compose by CI/deployment. This is not the application secret file.
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com
IMAGE_TAG=replace-with-git-sha
API_DOMAIN=devmatch-api.duckdns.org
CADDY_EMAIL=ops@example.com
# On EC2 this becomes /opt/devmatch/runtime.env, rendered from AWS SSM.
RUNTIME_ENV_FILE=./runtime.env.example
