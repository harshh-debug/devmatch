#!/usr/bin/env bash
set -euo pipefail

dnf install -y docker jq
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent

install -d -m 0755 /usr/local/lib/docker/cli-plugins
curl --fail --silent --show-error --location \
  https://github.com/docker/compose/releases/download/v2.32.4/docker-compose-linux-x86_64 \
  --output /usr/local/lib/docker/cli-plugins/docker-compose
chmod 0755 /usr/local/lib/docker/cli-plugins/docker-compose

install -d -m 0755 /opt/devmatch/releases /opt/devmatch/current
printf '%s' '${deploy_script_base64}' | base64 --decode > /usr/local/bin/devmatch-deploy
chmod 0755 /usr/local/bin/devmatch-deploy

if ! swapon --show | grep -q /swapfile; then
  fallocate -l 2G /swapfile
  chmod 0600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
sysctl -w vm.swappiness=10
printf 'vm.swappiness=10\n' > /etc/sysctl.d/99-devmatch.conf

install -d -m 0755 /etc/docker
printf '%s\n' '{"log-driver":"local","log-opts":{"max-size":"10m","max-file":"3"}}' > /etc/docker/daemon.json
systemctl restart docker
